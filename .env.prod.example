# Copy to .env on the server and fill in. Never commit the filled-in copy.
#
#   MARIADB_PASSWORD and MARIADB_ROOT_PASSWORD:  openssl rand -hex 24
#
COMPOSE_PROJECT_NAME=techscope

MARIADB_DATABASE=techscope
MARIADB_USER=techscope
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Must match TECHSCOPE_DOMAIN below, with the scheme and no trailing slash.
WP_SITE_URL=https://techscope.example.com
TECHSCOPE_DOMAIN=techscope.example.com

# Let's Encrypt sends expiry warnings here.
TECHSCOPE_TLS_EMAIL=you@example.com
